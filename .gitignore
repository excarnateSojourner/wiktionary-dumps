# Ignore Wiktionary dump directories, which I name based on the date of the dump (with the year first)
2*

# Ignore dump directories from other wikis
source-*

# Ignore obsolete scripts
archive
sandbox.*
test/output_data/*

# Vim swap files
*.swp

# Python caches
__pycache__/

# line_profiler / kernprof
*.lprof

